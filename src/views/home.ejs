<%- include('includes/header') %>
<link rel="stylesheet" type="text/css" href="/css/home.css" />

<body>
  <div class="home-container">
    <%- include('includes/navbar') %>

    <main class="home-main-wrap">
      <!-- Hero Command Banner -->
      <section class="home-hero">
        <div class="home-hero-badge">
          <span class="pulse-dot"></span>
          <span>Live Operations Console</span>
        </div>
        <h1 class="home-hero-title">
          <% if (member) { %>
            Welcome back, Chef <%= member.memberNick %>
          <% } else { %>
            Haute Gastronomy &bull; Burak Atelier
          <% } %>
        </h1>
        <p class="home-hero-desc">
          Orchestrate restaurant operations, curate signature dishes, manage table reservations, and monitor customer engagements through a refined administrative environment.
        </p>

        <div class="home-hero-actions">
          <% if (member) { %>
            <a href="/admin/product/all" class="btn-accent">
              <i class="fa-solid fa-book-open"></i>
              <span>Open Menu Manager</span>
            </a>
            <a href="/admin/user/all" class="btn-ghost">
              <i class="fa-solid fa-users"></i>
              <span>Patrons Directory</span>
            </a>
          <% } else { %>
            <a href="/admin/login" class="btn-accent">
              <i class="fa-solid fa-right-to-bracket"></i>
              <span>Sign In to Console</span>
            </a>
            <a href="/admin/signup" class="btn-ghost">
              <i class="fa-solid fa-user-plus"></i>
              <span>Create Restaurant Account</span>
            </a>
          <% } %>
        </div>
      </section>

      <!-- Action Cards -->
      <section class="home-cards-grid">
        <!-- Card 1: Menu Management -->
        <a href="/admin/product/all" class="burak-card">
          <div class="burak-card-top">
            <div class="burak-card-icon">
              <i class="fa-solid fa-utensils"></i>
            </div>
            <span class="burak-card-tag">Culinary Catalog</span>
          </div>
          <h2 class="burak-card-title">Menu Management</h2>
          <p class="burak-card-desc">
            Organize dishes, salads, desserts, and drinks. Adjust pricing, portion volumes, stock inventory, and real-time menu availability.
          </p>
          <div class="burak-card-link">
            <span>Access Menu</span>
            <i class="fa-solid fa-arrow-right"></i>
          </div>
        </a>

        <!-- Card 2: Users & Patrons -->
        <a href="/admin/user/all" class="burak-card">
          <div class="burak-card-top">
            <div class="burak-card-icon">
              <i class="fa-solid fa-address-book"></i>
            </div>
            <span class="burak-card-tag">Accounts & Staff</span>
          </div>
          <h2 class="burak-card-title">Patrons Directory</h2>
          <p class="burak-card-desc">
            Browse registered diners and system users. Audit contact telephone numbers and control membership status permissions.
          </p>
          <div class="burak-card-link">
            <span>View Patrons</span>
            <i class="fa-solid fa-arrow-right"></i>
          </div>
        </a>

        <!-- Card 3: Quick Add Item -->
        <a href="/admin/product/all?openCreate=true" class="burak-card">
          <div class="burak-card-top">
            <div class="burak-card-icon">
              <i class="fa-solid fa-circle-plus"></i>
            </div>
            <span class="burak-card-tag">New Additions</span>
          </div>
          <h2 class="burak-card-title">Launch New Dish</h2>
          <p class="burak-card-desc">
            Introduce new seasonal recipes or specialty drinks into the live catalog with high-resolution culinary photography.
          </p>
          <div class="burak-card-link">
            <span>Create Item</span>
            <i class="fa-solid fa-arrow-right"></i>
          </div>
        </a>
      </section>


    </main>
  </div>

<%- include('includes/footer') %>
