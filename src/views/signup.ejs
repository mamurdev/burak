<%- include('includes/header') %>
<link rel="stylesheet" type="text/css" href="/css/login.css" />
<link rel="stylesheet" type="text/css" href="/css/signup.css" />

<body>
  <div class="auth-page-container">
    <div class="auth-card signup-card-wide">
      <div class="auth-header">
        <div class="auth-brand-emblem">
          <i class="fa-solid fa-utensils"></i>
        </div>
        <h1 class="auth-title">Register Restaurant</h1>
        <p class="auth-subtitle">Establish your culinary management profile</p>
      </div>

      <form
        action="/admin/signup"
        method="POST"
        enctype="multipart/form-data"
        id="signup-form"
      >
        <input type="hidden" name="memberType" value="RESTAURANT" />

        <div class="auth-grid-2">
          <!-- Restaurant Name -->
          <div class="burak-form-group">
            <label class="burak-label">
              <span>Restaurant / Brand</span>
              <span class="required">*</span>
            </label>
            <div class="auth-input-wrapper">
              <input
                type="text"
                name="memberNick"
                class="burak-input member-nick"
                placeholder="e.g. Burak Istanbul"
                required
                autofocus
              />
              <i class="fa-solid fa-store input-icon"></i>
            </div>
          </div>

          <!-- Phone Number -->
          <div class="burak-form-group">
            <label class="burak-label">
              <span>Contact Telephone</span>
              <span class="required">*</span>
            </label>
            <div class="auth-input-wrapper">
              <input
                type="tel"
                name="memberPhone"
                class="burak-input member-phone"
                placeholder="+82 10-0000-0000"
                required
              />
              <i class="fa-solid fa-phone input-icon"></i>
            </div>
          </div>
        </div>

        <div class="auth-grid-2">
          <!-- Password -->
          <div class="burak-form-group">
            <label class="burak-label">
              <span>Master Password</span>
              <span class="required">*</span>
            </label>
            <div class="auth-input-wrapper">
              <input
                type="password"
                name="memberPassword"
                id="signup-password"
                class="burak-input member-password"
                placeholder="Create password"
                required
              />
              <i class="fa-solid fa-lock input-icon"></i>
              <button
                type="button"
                class="pwd-toggle-btn"
                onclick="togglePasswordVisibility('signup-password', this)"
                title="Toggle password view"
              >
                <i class="fa-regular fa-eye"></i>
              </button>
            </div>
          </div>

          <!-- Repeat Password -->
          <div class="burak-form-group">
            <label class="burak-label">
              <span>Confirm Password</span>
              <span class="required">*</span>
            </label>
            <div class="auth-input-wrapper">
              <input
                type="password"
                name="confirmPassword"
                id="signup-confirm-password"
                class="burak-input confirm-password"
                placeholder="Repeat password"
                required
              />
              <i class="fa-solid fa-shield-halved input-icon"></i>
              <button
                type="button"
                class="pwd-toggle-btn"
                onclick="togglePasswordVisibility('signup-confirm-password', this)"
                title="Toggle password view"
              >
                <i class="fa-regular fa-eye"></i>
              </button>
            </div>
          </div>
        </div>

        <!-- Restaurant Image Upload Area -->
        <div class="avatar-upload-wrap">
          <div class="avatar-preview-box" style="width: 80px; height: 80px; min-width: 80px; min-height: 80px; max-width: 80px; max-height: 80px; border-radius: 12px; overflow: hidden; flex-shrink: 0;">
            <img
              src="/img/default.jpeg"
              id="signup-avatar-preview"
              class="avatar-preview-img"
              alt="Restaurant Avatar"
              style="width: 100%; height: 100%; max-width: 80px; max-height: 80px; object-fit: cover; display: block;"
            />
          </div>
          <div class="avatar-meta">
            <span class="avatar-meta-title">Restaurant Profile Image</span>
            <span class="avatar-meta-desc">
              Upload your official restaurant emblem or culinary banner (JPG, PNG, or WEBP).
            </span>
            <span id="avatar-file-name" style="font-size: 0.75rem; color: var(--accent-gold); font-weight: 600;"></span>
            <label for="input-file" class="avatar-choose-btn">
              <i class="fa-solid fa-cloud-arrow-up"></i>
              <span>Select File</span>
            </label>
            <input
              type="file"
              id="input-file"
              class="member-image"
              name="memberImage"
              accept="image/jpeg,image/png,image/webp,image/jpg"
              style="display: none;"
              required
            />
          </div>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn-accent auth-submit-btn">
          <i class="fa-solid fa-user-plus"></i>
          <span>Complete Registration</span>
        </button>

        <!-- Footer Links -->
        <div class="auth-footer-links">
          <div>
            Already registered?
            <a href="/admin/login">Sign in here</a>
          </div>
          <div>
            <a href="/admin">
              <i class="fa-solid fa-arrow-left fa-xs mr-1"></i>
              Return to Public Portal
            </a>
          </div>
        </div>
      </form>
    </div>
  </div>

  <script type="text/javascript" src="/js/signup.js"></script>
  <script>
    function togglePasswordVisibility(inputId, btn) {
      const input = document.getElementById(inputId);
      const icon = btn.querySelector('i');
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
      } else {
        input.type = 'password';
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
      }
    }
  </script>
</body>

<%- include('includes/footer') %>
